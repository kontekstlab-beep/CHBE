# Скопируйте в .env и подставьте СВОИ ключи Binance TESTNET.
# .env в git НЕ коммитится (см. .gitignore). Ключи вводите только вы.
# Одни и те же переменные используются для обоих testnet-режимов:
#   фьючерсы (--live --testnet)        — ключ с testnet.binancefuture.com
#   спот (--live --testnet --spot)     — ключ с testnet.binance.vision (вход через GitHub)
BINANCE_TESTNET_KEY=your_testnet_api_key
BINANCE_TESTNET_SECRET=your_testnet_api_secret
